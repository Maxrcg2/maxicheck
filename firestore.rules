rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada persona autenticada solo puede consultar y modificar su propia lista.
    match /users/{userId}/savedTitles/{contentId} {
      allow read, create, update, delete:
        if request.auth != null && request.auth.uid == userId;
    }

    // Todo documento que no pertenezca a la ruta anterior queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
